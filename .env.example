# DocuRidge — environment configuration template.
# Copy to .env on first boot. The compose entrypoint will fill in
# any blank required values that have safe randomized defaults
# (BOOTSTRAP_TOKEN, SESSION_SECRET, JWS_SIGNING_TOKEN_SECRET).

# ─── Public URL (canonical absolute base used in emails & token URLs) ───
PUBLIC_URL=http://localhost:3737

# Optional AI field suggestions. Disabled until BOTH base URL and model are set.
# Use a vision-capable chat-completions-compatible provider; API root, not the
# full /chat/completions URL. These settings stay on the server. See
# docs/ai-field-suggestions.md for data handling, limits, and provider setup.
DOCURIDGE_AI_BASE_URL=
DOCURIDGE_AI_MODEL=
# Optional for a local provider with no authentication; required by most hosted APIs.
DOCURIDGE_AI_API_KEY=

# Additional origins allowed to make state-changing (POST/PUT/PATCH/DELETE)
# requests, comma-separated. PUBLIC_URL and loopback are always trusted, so
# leave this empty unless the app is reachable at a second hostname (e.g. a
# Tailscale `tailscale serve` name, which forwards its own Host/Origin and
# so never matches PUBLIC_URL). Absolute origins only, no trailing path:
#   TRUSTED_ORIGINS=https://host.example.ts.net,https://alt.example.com
# TRUSTED_ORIGINS=

# ─── Compose project ────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=docuridge

# ─── Host port bindings (only postgres/mailhog bind to 127.0.0.1) ───────
APP_INTERNAL_PORT=3000             # inside container; reverse proxy reaches via docker network
POSTGRES_HOST_PORT=54317
MAILHOG_UI_HOST_PORT=8737
MAILHOG_SMTP_HOST_PORT=10737

# ─── Database ───────────────────────────────────────────────────────────
POSTGRES_DB=docuridge
POSTGRES_USER=docuridge
POSTGRES_PASSWORD=change-me-in-real-deploy
DATABASE_URL=postgresql://docuridge:change-me-in-real-deploy@docuridge_postgres:5432/docuridge?schema=public

# ─── Mail backend ───────────────────────────────────────────────────────
# Options: mailhog | smtp_relay
MAIL_BACKEND=mailhog

# MailHog (dev default)
MAILHOG_HOST=docuridge_mailhog
MAILHOG_PORT=1025

# Production SMTP relay (only used when MAIL_BACKEND=smtp_relay; allowlist enforced in code)
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=25

# Set to true ONLY for a relay with a self-signed / unverifiable certificate.
# Outbound mail carries per-recipient signing links, so turning verification
# off exposes them to anyone on the path between the app and the relay. Leave
# unset (or false) for any relay with a normal CA-issued certificate.
# SMTP_RELAY_ALLOW_INVALID_CERT=false

# Default From address (org branding overrides per-org)
MAIL_FROM_DEFAULT="DocuRidge <docuridge@example.com>"

# Recipient allowlist — comma-separated. Empty = nothing sends in smtp_relay mode.
# This is a code-level safety net; see DEPLOYMENT.md for removal procedure.
MAIL_ALLOWLIST=

# ─── Webhooks ─────────────────────────────────────────────────────────────
# Hostnames allowed to receive webhooks even though they resolve to a private,
# loopback, or link-local address. Comma-separated. Empty by default: webhook
# URLs are admin-supplied and the app shares a Docker network with Postgres and
# MailHog, so an unrestricted target lets the dispatcher probe your internal
# network. Add a host only when you deliberately webhook inside it.
# WEBHOOK_ALLOWED_INTERNAL_HOSTS=

# ─── Cryptographic secrets ──────────────────────────────────────────────
# All three are auto-generated by docker-entrypoint.sh on first boot
# if absent. Rotate by replacing the value and restarting.

SESSION_SECRET=                 # 32-byte random base64 — server-side session signing
JWS_SIGNING_TOKEN_SECRET=       # 32-byte random base64 — signs recipient signing tokens
JWS_RESET_TOKEN_SECRET=         # 32-byte random base64 — signs password-reset/email-verify tokens

# Bootstrap admin token — gates the one-time /setup route
BOOTSTRAP_TOKEN=                # auto-generated on first boot if blank
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME="DocuRidge Admin"
BOOTSTRAP_ORG_NAME="Acme Org"
BOOTSTRAP_ORG_SLUG="acme"

# ─── Auth policy ────────────────────────────────────────────────────────
SESSION_TTL_HOURS=12

# Minimum seconds between `Session.lastSeenAt` writes. getSession() is called
# many times per request, and the timestamp is only used for operator
# visibility, so writing it on every read costs WAL and dead tuples for no
# benefit. 0 disables throttling (write every time).
# SESSION_HEARTBEAT_SECONDS=60

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Number of trusted reverse proxies in front of the app. The client IP is read
# this many entries from the right of X-Forwarded-For, because nginx appends
# rather than overwrites — entries further left are client-supplied and
# forgeable. The default of 1 is correct for the standard single-nginx deploy.
# Raise it only if you add another proxy in front of nginx (e.g. a CDN).
# TRUSTED_PROXY_HOPS=1

# ─── Rate limits (in-process token bucket; per-IP unless noted) ─────────
RL_LOGIN_PER_MIN=10
RL_REGISTER_PER_MIN=5
RL_PASSWORD_RESET_PER_MIN=3
RL_SIGNING_TOKEN_PER_MIN=30

# Minimum minutes between opportunistic prunes of expired rate-limit buckets.
# The table is insert-only on every rate-limited request, so without this it
# grows without bound.
# RATELIMIT_CLEANUP_INTERVAL_MINUTES=15

# Share-link views per minute, per link, before the page refuses to render.
RL_SHARE_VIEW_PER_MIN=20

# Minutes during which repeat views of the same share link bump the view
# counter WITHOUT appending another audit-chain event. The chain is append-only
# and signed per event, and the share page is unauthenticated, so one event per
# window keeps the trail readable and bounds the cost of a refresh loop.
SHARE_VIEW_AUDIT_WINDOW_MINUTES=60

# ─── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal
NODE_ENV=production

# ─── Storage (local filesystem in v1) ───────────────────────────────────
UPLOADS_DIR=/data/uploads
SEALED_DIR=/data/sealed
KEYS_DIR=/data/keys
MAX_UPLOAD_BYTES=26214400        # 25 MB

# Per-signature cap on the decoded signature/initials PNG a recipient may adopt
# (bytes, default 2 MB). Stored as base64 text and re-embedded on every seal,
# so an uncapped image inflates both the database row and the sealed PDF.
# MAX_SIGNATURE_IMAGE_BYTES=2097152

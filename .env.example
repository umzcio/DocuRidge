# DocuRidge — environment configuration template.
# Copy to .env on first boot. The compose entrypoint will fill in
# any blank required values that have safe randomized defaults
# (BOOTSTRAP_TOKEN, SESSION_SECRET, JWS_SIGNING_TOKEN_SECRET).

# ─── Public URL (canonical absolute base used in emails & token URLs) ───
PUBLIC_URL=http://localhost:3737

# Optional AI field suggestions. Disabled until BOTH base URL and model are set.
# Use a vision-capable chat-completions-compatible provider; API root, not the
# full /chat/completions URL. These settings stay on the server. See
# docs/ai-field-suggestions.md for data handling, limits, and provider setup.
DOCURIDGE_AI_BASE_URL=
DOCURIDGE_AI_MODEL=
# Optional for a local provider with no authentication; required by most hosted APIs.
DOCURIDGE_AI_API_KEY=

# Additional origins allowed to make state-changing (POST/PUT/PATCH/DELETE)
# requests, comma-separated. PUBLIC_URL and loopback are always trusted, so
# leave this empty unless the app is reachable at a second hostname (e.g. a
# Tailscale `tailscale serve` name, which forwards its own Host/Origin and
# so never matches PUBLIC_URL). Absolute origins only, no trailing path:
#   TRUSTED_ORIGINS=https://host.example.ts.net,https://alt.example.com
# TRUSTED_ORIGINS=

# ─── Compose project ────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=docuridge

# ─── Host port bindings (only postgres/mailhog bind to 127.0.0.1) ───────
APP_INTERNAL_PORT=3000             # inside container; reverse proxy reaches via docker network
POSTGRES_HOST_PORT=54317
MAILHOG_UI_HOST_PORT=8737
MAILHOG_SMTP_HOST_PORT=10737

# ─── Database ───────────────────────────────────────────────────────────
POSTGRES_DB=docuridge
POSTGRES_USER=docuridge
POSTGRES_PASSWORD=change-me-in-real-deploy
DATABASE_URL=postgresql://docuridge:change-me-in-real-deploy@docuridge_postgres:5432/docuridge?schema=public

# ─── Mail backend ───────────────────────────────────────────────────────
# Options: mailhog | smtp_relay
MAIL_BACKEND=mailhog

# MailHog (dev default)
MAILHOG_HOST=docuridge_mailhog
MAILHOG_PORT=1025

# Production SMTP relay (only used when MAIL_BACKEND=smtp_relay; allowlist enforced in code)
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=25

# Set to true ONLY for a relay with a self-signed / unverifiable certificate.
# Outbound mail carries per-recipient signing links, so turning verification
# off exposes them to anyone on the path between the app and the relay. Leave
# unset (or false) for any relay with a normal CA-issued certificate.
# SMTP_RELAY_ALLOW_INVALID_CERT=false

# Default From address (org branding overrides per-org)
MAIL_FROM_DEFAULT="DocuRidge <docuridge@example.com>"

# Recipient allowlist — comma-separated. Empty = nothing sends in smtp_relay mode.
# This is a code-level safety net; see DEPLOYMENT.md for removal procedure.
MAIL_ALLOWLIST=

# ─── Webhooks ─────────────────────────────────────────────────────────────
# Hostnames allowed to receive webhooks even though they resolve to a private,
# loopback, or link-local address. Comma-separated, matched exactly against the
# URL's host. Empty by default: webhook URLs are admin-supplied and the app
# shares a Docker network with Postgres and MailHog, so every webhook host is
# resolved and refused if any address is internal. Add a host only when you
# deliberately webhook inside it (the connection is still pinned to the
# address that was checked).
# WEBHOOK_ALLOWED_INTERNAL_HOSTS=

# ─── SSO ──────────────────────────────────────────────────────────────────
# Org admins set the OIDC issuer in the UI, and the server fetches its
# metadata, token and userinfo endpoints. Those hosts get the same check as
# webhooks. List an IdP hostname here only if it really is on your internal
# network. Comma-separated, matched exactly.
# SSO_ALLOWED_INTERNAL_HOSTS=

# ─── Cryptographic secrets ──────────────────────────────────────────────
# All three are auto-generated by docker-entrypoint.sh on first boot
# if absent. Rotate by replacing the value and restarting.

SESSION_SECRET=                 # 32-byte random base64 — server-side session signing
JWS_SIGNING_TOKEN_SECRET=       # 32-byte random base64 — signs recipient signing tokens
JWS_RESET_TOKEN_SECRET=         # 32-byte random base64 — signs password-reset/email-verify tokens

# Bootstrap admin token — gates the one-time /setup route
BOOTSTRAP_TOKEN=                # auto-generated on first boot if blank
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME="DocuRidge Admin"
BOOTSTRAP_ORG_NAME="Acme Org"
BOOTSTRAP_ORG_SLUG="acme"

# ─── Auth policy ────────────────────────────────────────────────────────
SESSION_TTL_HOURS=12

# Minimum seconds between `Session.lastSeenAt` writes. getSession() is called
# many times per request, and the timestamp is only used for operator
# visibility, so writing it on every read costs WAL and dead tuples for no
# benefit. 0 disables throttling (write every time).
# SESSION_HEARTBEAT_SECONDS=60

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=15
# Per-recipient signing access-code lockout: after N wrong codes the recipient
# is locked for LOCK_MINUTES, doubling per lockout up to LOCK_MAX_MINUTES.
ACCESS_CODE_MAX_ATTEMPTS=5
ACCESS_CODE_LOCK_MINUTES=15
ACCESS_CODE_LOCK_MAX_MINUTES=1440
PASSWORD_MIN_LENGTH=12

# SSO bindings: which org may use which OIDC issuer. Comma-separated
# <org-slug>=<issuer-url> entries; the slug is the Organisation's slug and the
# issuer must match that org's SSO settings exactly, e.g.
#   SSO_TRUSTED_ISSUERS=campus=https://login.example.edu/tenant/v2.0
# Only the bound org can save or use the issuer: SSO trusts the issuer's email
# claim, and open registration makes anyone an org admin, so an issuer trusted
# for every org would let a self-registered org capture its users. Each slug
# may appear once. A malformed entry (no "=", empty slug, non-https issuer,
# duplicate slug) stops the app from starting. Empty disables SSO. With
# several bound orgs, the login page shows one "Sign in with SSO" button each.
# SSO_TRUSTED_ISSUERS=

# Number of trusted reverse proxies in front of the app. The client IP is read
# this many entries from the right of X-Forwarded-For, because nginx appends
# rather than overwrites — entries further left are client-supplied and
# forgeable. The default of 1 is correct for the standard single-nginx deploy.
# Raise it only if you add another proxy in front of nginx (e.g. a CDN).
# TRUSTED_PROXY_HOPS=1

# ─── Rate limits (in-process token bucket; per-IP unless noted) ─────────
RL_LOGIN_PER_MIN=10
# Login attempts per minute against one email address, from any source IP.
RL_LOGIN_ACCOUNT_PER_MIN=10
RL_REGISTER_PER_MIN=5
RL_PASSWORD_RESET_PER_MIN=3
RL_SIGNING_TOKEN_PER_MIN=30

# Minimum minutes between opportunistic prunes of expired rate-limit buckets.
# The table is insert-only on every rate-limited request, so without this it
# grows without bound.
# RATELIMIT_CLEANUP_INTERVAL_MINUTES=15

# Share-link views per minute, per link, before the page refuses to render.
RL_SHARE_VIEW_PER_MIN=20

# Minutes during which repeat views of the same share link bump the view
# counter WITHOUT appending another audit-chain event. The chain is append-only
# and signed per event, and the share page is unauthenticated, so one event per
# window keeps the trail readable and bounds the cost of a refresh loop.
SHARE_VIEW_AUDIT_WINDOW_MINUTES=60

# ─── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal
NODE_ENV=production

# ─── Storage (local filesystem in v1) ───────────────────────────────────
UPLOADS_DIR=/data/uploads
SEALED_DIR=/data/sealed
KEYS_DIR=/data/keys
MAX_UPLOAD_BYTES=26214400        # 25 MB

# Ceilings on how much data may be inflated from a PDF's compressed streams
# (FlateDecode, LZW, ...). The upload cap bounds only the ENCODED size; nested
# FlateDecode can expand a few hundred bytes to gigabytes. Enforced when an
# upload is parsed (including every page's /Contents), at seal time, and by
# `npm run verify`. A PDF that exceeds them is rejected as "too complex".
# PDF_MAX_DECODED_STREAM_BYTES=67108864    # 64 MiB, any single stream
# PDF_MAX_DECODED_TOTAL_BYTES=268435456    # 256 MiB, all streams in one parse/seal step

# Ceilings on what sealing copies out of one uploaded PDF. Sealing embeds all
# of a document's pages in one pass, so a resource shared by many pages counts
# once; each page's content counts again per page. Checked at upload (refused
# as "too complex") and again at seal time.
# PDF_MAX_PAGES=2000
# PDF_MAX_SEAL_OBJECTS=1000000       # dictionary entries + array elements reachable from pages
# PDF_MAX_SEAL_BYTES=134217728       # 128 MiB of stream data reachable from pages

# Envelope-wide ceilings. One seal copies every document of an envelope into
# one output, so the per-document costs above are also capped in sum. Checked
# when a document is added, when the envelope is sent (template and public-form
# documents included) and at seal time.
# PDF_MAX_ENVELOPE_ITEMS=25
# PDF_MAX_ENVELOPE_PAGES=4000
# PDF_MAX_ENVELOPE_SEAL_OBJECTS=2000000
# PDF_MAX_ENVELOPE_SEAL_BYTES=268435456   # 256 MiB summed over the documents

# Ceilings on flattening a PDF's fillable form (AcroForm), which runs once,
# when the upload is canonicalized in the PDF worker. A form over a cap is
# refused at upload as "too complex"; sealing copies the canonical pages and
# does not flatten.
# PDF_MAX_FORM_FIELDS=2000           # field dictionaries in the form tree
# PDF_MAX_FORM_WIDGETS=2000          # widget annotations reachable from fields
# PDF_MAX_FORM_DEPTH=32              # /Kids nesting and /Parent chain length
# PDF_MAX_ANNOTATIONS=20000          # /Annots entries summed over every page

# Per-signature cap on the decoded signature/initials PNG a recipient may adopt
# (bytes, default 2 MB). Stored as base64 text and re-embedded on every seal,
# so an uncapped image inflates both the database row and the sealed PDF.
# MAX_SIGNATURE_IMAGE_BYTES=2097152

# Ceilings on the dimensions an embedded image (signature, initials, DRAWING,
# sender STAMP) may DECLARE in its PNG IHDR / JPEG SOF header. Decode cost
# follows the declared size, not the file size: a sub-KB PNG declaring
# 20000x20000 would cost gigabytes at seal time. Checked at submission and
# again just before the sealer embeds the image.
# MAX_IMAGE_DIMENSION=4096        # pixels per side
# MAX_IMAGE_PIXELS=8388608        # width x height (8 MP)
# Seal-wide image budget: width x height summed over the DISTINCT images one
# seal decodes (an image drawn by many fields is decoded once and counts once).
# SEAL_MAX_IMAGE_PIXELS=67108864  # 64 MP
# Field caps, enforced when fields are added, at send, and at template use.
# ENVELOPE_MAX_FIELDS=2000
# ENVELOPE_MAX_FIELDS_PER_PAGE=200

# PDF worker: uploaded and sealed PDFs are parsed in a fresh child process per
# job, with its own heap cap and time limit and no secrets in its environment.
# A job that waits longer than PDF_WORKER_QUEUE_MS for a free worker is refused
# as busy (retry later).
# Memory: the heap cap does not bound a job. Each running job can also hold
# up to PDF_MAX_DECODED_TOTAL_BYTES (256 MiB) of decoded streams outside the
# heap, plus its input and output buffers (a seal holds every source document
# of the envelope and the sealed file), and the app keeps its own copy of the
# sources of each seal running or queued. Size mem_limit for the app plus
# PDF_WORKER_CONCURRENCY x (PDF_WORKER_HEAP_MB + 256 MiB + ~3x your largest
# envelope's PDFs). docker-compose.yml sets mem_limit: 4g, which covers the
# default concurrency 2 x (512 MiB heap + 256 MiB decode/ArrayBuffer budget)
# plus the parent, with headroom.
# Encrypted uploads are decrypted by qpdf in the app container, outside the
# worker: at most 2 at a time (others wait up to 30 s, then busy), each capped
# at 1 GiB of address space and an output of 2 x MAX_UPLOAD_BYTES (a larger
# one is refused as too large; decryption leaves object streams uncompressed,
# so files grow). Those caps are fixed in src/lib/pdf/decrypt.ts.
# PDF_WORKER_HEAP_MB=512
# PDF_WORKER_CONCURRENCY=2
# PDF_WORKER_QUEUE_MS=30000
# PDF_JOB_TIMEOUT_UPLOAD_MS=30000    # upload inspection
# PDF_JOB_TIMEOUT_SEAL_MS=60000      # seal render

{
  "name": "docuridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync-pdf-worker && next dev",
    "prebuild": "node scripts/patch-next-flight-manifest.cjs",
    "build": "npm run sync-pdf-worker && npm run build:pdf-worker && npm run build:canonical-backfill && next build",
    "build:pdf-worker": "esbuild src/lib/pdf-worker/child.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/pdf-worker.cjs",
    "build:canonical-backfill": "esbuild scripts/canonical-backfill.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/canonical-backfill.cjs --external:@prisma/client --external:.prisma",
    "sync-pdf-worker": "node -e \"require('node:fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.mjs', 'public/pdf.worker.mjs')\"",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "e2e:up": "docker compose --env-file .env.e2e -p docuridge_e2e -f docker-compose.yml -f docker-compose.e2e.yml up --build -d",
    "e2e:down": "docker compose --env-file .env.e2e -p docuridge_e2e -f docker-compose.yml -f docker-compose.e2e.yml down -v",
    "test:e2e:isolated": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:3738/DocuRidge MAILHOG_API_URL=http://127.0.0.1:8738/api/v2/messages DOCURIDGE_APP_CONTAINER=docuridge_e2e_app BOOTSTRAP_TOKEN=e2e-bootstrap-token-not-real playwright test",
    "smoke:public": "playwright test tests/smoke",
    "verify": "tsx scripts/verify.ts",
    "prisma": "prisma",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "bootstrap-token": "tsx scripts/generate-bootstrap-token.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.1.1",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.5.24",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.27.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "happy-dom": "^15.11.7",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}

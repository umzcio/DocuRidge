# DocuRidge — ISOLATED e2e stack environment.
#
# Every value here is FABRICATED for the e2e stack only — never copied from
# the real .env, and never usable against the production deployment (it
# targets docuridge_e2e_postgres / docuridge_e2e_mailhog, not production).
#
# Usage: cp .env.e2e.example .env.e2e   (then npm run e2e:up)

PUBLIC_URL=http://127.0.0.1:3738/DocuRidge
COMPOSE_PROJECT_NAME=docuridge_e2e

POSTGRES_DB=docuridge_e2e
POSTGRES_USER=docuridge_e2e
POSTGRES_PASSWORD=e2e-only-not-a-real-secret

MAIL_BACKEND=mailhog
MAIL_ALLOWLIST=e2e@example.com,signer@example.com,delegate@example.com

SESSION_SECRET=e2e-session-secret-not-real-0000000000
JWS_SIGNING_TOKEN_SECRET=e2e-signing-secret-not-real-000000000
JWS_RESET_TOKEN_SECRET=e2e-reset-secret-not-real-00000000000

BOOTSTRAP_TOKEN=e2e-bootstrap-token-not-real
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

LOG_LEVEL=warn
